{
  "name": "zenvy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=smoke",
    "test:visual": "playwright test --project=visual-desktop --project=visual-mobile",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "db:seed:e2e": "node scripts/seed-e2e.mjs",
    "ci": "npm run prisma:validate && npm run lint && npm run typecheck && npm run test && npm run build",
    "postinstall": "prisma generate",
    "start:custom": "node server.js",
    "start:socket": "node standalone-socket.js"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@livekit/components-react": "^2.9.21",
    "@livekit/components-styles": "^1.2.0",
    "@prisma/client": "^5.22.0",
    "@prisma/engines": "^5.22.0",
    "@supabase/supabase-js": "^2.100.0",
    "@types/simple-peer": "^9.11.9",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.0.0",
    "livekit-client": "^2.19.1",
    "livekit-server-sdk": "^2.15.4",
    "lru-cache": "^11.2.7",
    "next": "^15.1.8",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19",
    "react-dom": "^19",
    "resend": "^6.9.4",
    "simple-peer": "^9.11.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "^15.1.8",
    "jsdom": "^26.1.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
