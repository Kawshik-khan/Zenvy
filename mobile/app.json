{
  "expo": {
    "name": "Zenvy",
    "slug": "zenvy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zenvy.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Zenvy uses the camera for video calls with study partners.",
        "NSMicrophoneUsageDescription": "Zenvy uses the microphone for calls with study partners."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zenvy.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Zenvy uses the camera for video calls with study partners.",
          "microphonePermission": "Zenvy uses the microphone for calls with study partners."
        }
      ]
    ],
    "scheme": "zenvy",
    "experiments": {
      "typedRoutes": true
    }
  }
}
