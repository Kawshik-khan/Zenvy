# Copy to .env (git-ignored) or set as EAS environment variables.
# Leave EXPO_PUBLIC_API_URL empty to run the app in demo mode on sample data.

# The Zenvy web app (Next.js), which serves /api/*
EXPO_PUBLIC_API_URL=https://your-zenvy-site.vercel.app

# The Socket.io server (standalone-socket.js on Render). Defaults to the API URL if unset.
EXPO_PUBLIC_SOCKET_URL=https://zenvy-socket.onrender.com
